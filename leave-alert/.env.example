LTA_ACCOUNT_KEY=
TELEGRAM_BOT_TOKEN=
# Telegram user ids allowed to use the bot, comma-separated (e.g. 12345678,87654321).
# Anyone else who messages the bot is told their id, so you can add them here.
TELEGRAM_ALLOWED_IDS=
# Where the bot's /web links point. Defaults to the local Vite dev server.
WEB_URL=http://localhost:5173/
# OneMap: a token from onemap.gov.sg works for 3 days.
# Add email + password so the server can renew it on its own.
ONEMAP_TOKEN=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
